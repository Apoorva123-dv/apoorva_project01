        "import matplotlib.pyplot as plt\n",
        "\n",
        "names = [\"Apoorva\", \"Rahul\", \"Sneha\", \"Kiran\", \"Anjali\"]\n",
        "salaries = [25000, 30000, 28000, 22000, 35000]\n",
        "\n",
        "plt.bar(names, salaries)\n",
        "\n",
        "plt.xlabel(\"Employees\")\n",
        "plt.ylabel(\"Salary\")\n",
        "plt.title(\"Salary Analysis\")\n",
        "\n",
        "plt.show()"
      ]
